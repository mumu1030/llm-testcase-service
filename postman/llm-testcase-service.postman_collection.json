              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();\n\npm.test(\"状态码是422\",() => {\n    pm.response.to.have.status(422);\n});\n\npm.test(\"错误类型是less_than_equal\",() => {\n    pm.expect(body.detail[0].type).to.eql(\"less_than_equal\");\n});\n\npm.test(\"loc包含case_count\",() => {\n    pm.expect(body.detail[0].loc).to.include(\"case_count\");\n});\n\npm.test(\"回显了超限的输入值\",() => {\n    pm.expect(body.detail[0].input).to.eql(4);\n});\n\n\n\n\n"
                ]
