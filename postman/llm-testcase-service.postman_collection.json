                "exec": [
                  "const body = pm.response.json()\n\npm.test(\"状态是200\",() => {\n    pm.response.to.have.status(200);\n});\n\npm.test(\"提示语有删除成功\",() => {\n    pm.expect(body.message).to.be.eql(\"删除成功\");\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
